# Copy this file to ~/.config/hostinger/naturaquell-pool-heat-pumps.env.
# Do not store the copied file inside this repository or the Obsidian vault.
HOSTINGER_SFTP_HOST=""
HOSTINGER_SFTP_USER=""
HOSTINGER_SFTP_PORT="22"
HOSTINGER_SFTP_IDENTITY_FILE="$HOME/.ssh/hostinger-naturaquell-ed25519"
# Use rsync when Hostinger SSH access supports it; otherwise use sftp.
HOSTINGER_DEPLOY_METHOD="sftp"
